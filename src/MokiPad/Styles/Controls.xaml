<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        WPF 全局资源字典。
        - Geometry：矢量图标路径，界面里用 Path 显示，缩放不会糊。
        - x:Key：给资源起名字，用 StaticResource/DynamicResource 引用。
        - 没有 x:Key 的 Style 是“隐式样式”，会自动作用于该类型的所有控件。
        - ControlTemplate 决定控件长什么样，Trigger 根据鼠标、焦点等状态切换外观。
    -->
    <Geometry x:Key="Icon.New">M12,5 L12,19 M5,12 L19,12</Geometry>
    <Geometry x:Key="Icon.NewFile">M5,3 L15,3 20,8 20,21 5,21 Z M15,3 L15,8 20,8 M9,14 L16,14 M12.5,10.5 L12.5,17.5</Geometry>
    <Geometry x:Key="Icon.File">M5,3 L15,3 20,8 20,21 5,21 Z M15,3 L15,8 20,8</Geometry>
    <Geometry x:Key="Icon.Code">M8,6 L2,12 8,18 M16,6 L22,12 16,18 M14,4 L10,20</Geometry>
    <Geometry x:Key="Icon.Split">M3,4 L21,4 21,20 3,20 Z M12,4 L12,20</Geometry>
    <Geometry x:Key="Icon.Read">M2,12 C7,3 17,3 22,12 C17,21 7,21 2,12 Z M15,12 A3,3 0 1 1 9,12 A3,3 0 1 1 15,12</Geometry>
    <Geometry x:Key="Icon.Open">M3,19 L3,5 9,5 11,8 21,8 21,19 Z</Geometry>
    <Geometry x:Key="Icon.Save">M5,3 L17,3 21,7 21,21 3,21 3,3 Z M7,3 L7,9 16,9 16,3 M7,21 L7,14 17,14 17,21</Geometry>
    <Geometry x:Key="Icon.Search">M18,18 L22,22 M19,11 A8,8 0 1 1 3,11 A8,8 0 1 1 19,11</Geometry>
    <Geometry x:Key="Icon.Outline">M4,5 L20,5 M4,11 L15,11 M4,17 L10,17</Geometry>
    <Geometry x:Key="Icon.Recent">M3,11 A9,9 0 1 1 5,19 M3,4 L3,11 10,11 M12,7 L12,13 16,15</Geometry>
    <Geometry x:Key="Icon.Theme">M21,12.79 A9,9 0 1 1 11.21,3 A7,7 0 0 0 21,12.79 Z</Geometry>
    <Geometry x:Key="Icon.Sun">M16,12 A4,4 0 1 1 8,12 A4,4 0 1 1 16,12 M12,2 L12,4 M12,20 L12,22 M2,12 L4,12 M20,12 L22,12 M5,5 L6.5,6.5 M17.5,17.5 L19,19 M5,19 L6.5,17.5 M17.5,6.5 L19,5</Geometry>
    <Geometry x:Key="Icon.Copy">M8,8 L21,8 21,21 8,21 Z M4,16 L3,16 3,3 16,3 16,4</Geometry>
    <Geometry x:Key="Icon.Notebook">M6,3 L21,3 21,21 6,21 Z M17,3 L17,21 M3,7 L8,7 M3,12 L8,12 M3,17 L8,17</Geometry>
    <Geometry x:Key="Icon.Gear">M9,3 L15,3 15,5.5 18,7.5 20.5,7 22,12 20,14 19,17 19.5,19.5 15,22 13,20 10,20 8,22 3.5,19.5 4,17 3,14 1.5,12 3.5,7 6,7.5 9,5.5 Z M16,12.5 A4,4 0 1 1 8,12.5 A4,4 0 1 1 16,12.5</Geometry>
    <Style x:Key="KeyboardFocus" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="6" Margin="1" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Geometry x:Key="Icon.Pin">M8,3 L16,3 15,10 19,15 5,15 9,10 Z M12,15 L12,22</Geometry>
    <Geometry x:Key="Icon.Close">M6,6 L18,18 M6,18 L18,6</Geometry>
    <Geometry x:Key="Icon.Minimize">M5,12 L19,12</Geometry>
    <Geometry x:Key="Icon.Maximize">M5,5 L19,5 19,19 5,19 Z</Geometry>
    <Geometry x:Key="Icon.Settings">M12,8 A4,4 0 1 1 12,16 A4,4 0 1 1 12,8 M12,2 L12,5 M12,19 L12,22 M2,12 L5,12 M19,12 L22,12 M5,5 L7,7 M17,17 L19,19 M5,19 L7,17 M17,7 L19,5</Geometry>
        <!-- 鼠标悬停提示：圆角、阴影、跟随主题的弹出层。 -->
<Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Popup}" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border}" /><Setter Property="Padding" Value="10,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
        <!-- 普通按钮的默认样式：去边框、圆角、悬停/按下变色。 -->
<Style TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,7" /><Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="650" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Selected}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value=".4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
        <!-- 图标按钮：在普通按钮基础上固定尺寸，适合标题栏和工具栏。 -->
<Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="32" /><Setter Property="Height" Value="32" />
        <Setter Property="FontSize" Value="16" /><Setter Property="Padding" Value="8" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Viewbox Width="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                             Height="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}">
                        <Canvas Width="24" Height="24">
                            <Path Data="{Binding}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
        <!-- 标签项：选中时变色，右侧关闭按钮由 DataTemplate 提供。 -->
<Style x:Key="DocumentTabItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Secondary}" />
        <Setter Property="Padding" Value="14,0,10,0" /><Setter Property="Height" Value="39" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="TabSurface" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom" Background="Transparent"
                                Margin="12,0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Underline" Property="Background" Value="{DynamicResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
        <!-- 单选按钮：用自定义圆点代替系统外观。 -->
<Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Secondary}" /><Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="15,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface}" />
                            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
        <!-- 文本框：无边框、透明背景，用于阅读器里的少量输入场景。 -->
<Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Accent}" /><Setter Property="Padding" Value="8,5" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
        <!-- 菜单容器：控制弹出菜单的圆角和阴影。 -->
<Style TargetType="Menu">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>
        <!-- 菜单项：图标列、标题列、快捷键列，以及勾选标记。 -->
<Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="13" /><Setter Property="Padding" Value="10,7" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="Row" CornerRadius="6" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" /><ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="MenuIcon" ContentSource="Icon" Width="16" Height="16"
                                                  VerticalAlignment="Center" HorizontalAlignment="Left" />
                                <Path x:Name="Check" Grid.Column="0" Data="M2,6 L5,9 11,2"
                                      Stroke="{DynamicResource Accent}" StrokeThickness="1.6" StrokeLineJoin="Round"
                                      StrokeEndLineCap="Round" Width="12" Height="12" VerticalAlignment="Center"
                                      Visibility="Collapsed" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                                  VerticalAlignment="Center" Margin="7,0,16,0" />
                                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                                           Foreground="{DynamicResource Secondary}" FontSize="12"
                                           VerticalAlignment="Center" Margin="16,0,0,0" />
                                <Path x:Name="Arrow" Grid.Column="3" Data="M1,1 L5,5 1,9"
                                      Stroke="{DynamicResource Secondary}" StrokeThickness="1.4" Width="6" Height="10"
                                      Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Right"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Background="{DynamicResource Popup}" BorderBrush="{DynamicResource Border}"
                                    BorderThickness="1" CornerRadius="9" Padding="5">
                                <ItemsPresenter />
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Hover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            <Setter TargetName="MenuIcon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Row" Property="Opacity" Value=".4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
        <!-- 菜单分隔线。 -->
<Style TargetType="Separator">
        <Setter Property="Margin" Value="8,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{DynamicResource Border}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
        <!-- 右键菜单：自定义圆角、内边距和阴影。 -->
<Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="Background" Value="{DynamicResource Popup}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
        <Setter Property="MinWidth" Value="210" /><Setter Property="MaxWidth" Value="420" />
        <Setter Property="FontSize" Value="13" /><Setter Property="Padding" Value="5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border x:Name="Surface" Margin="8" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity=".18" />
                        </Border.Effect>
                        <Border.RenderTransform>
                            <TranslateTransform />
                        </Border.RenderTransform>
                        <ScrollViewer MaxHeight="520" HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition
                                    Binding="{Binding IsVisible, RelativeSource={RelativeSource TemplatedParent}}"
                                    Value="True" />
                                <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}"
                                           Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Surface"
                                                         Storyboard.TargetProperty="Opacity" From="0" To="1"
                                                         Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="Surface"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         From="4" To="0" Duration="0:0:0.14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
        <!-- 任务列表的复选框：只用于显示，不接收鼠标事件。 -->
<Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <DockPanel>
                        <Border x:Name="Box" DockPanel.Dock="Left" Width="14" Height="14" VerticalAlignment="Center"
                                BorderThickness="1" BorderBrush="{DynamicResource Border}" CornerRadius="3"
                                Background="{DynamicResource Surface}">
                            <Path x:Name="Tick" Data="M2,6 L5,9 10,3" Stroke="White" StrokeThickness="1.7"
                                  StrokeLineJoin="Round" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter x:Name="Label" VerticalAlignment="Center" Margin="7,0,0,0" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
        <!-- 通用列表：去掉边框和默认选中高亮。 -->
<Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    </Style>
        <!-- 列表项：透明背景，避免虚拟化时出现闪烁。 -->
<Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="10,8" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Tint}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{DynamicResource Thumb}" CornerRadius="4" Margin="2" MinHeight="22"
                            MinWidth="5" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
        <!-- 滚动条：细窄样式，滑块颜色跟随主题。 -->
<Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10" /><Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ScrollThumb}" />
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                        </Track.IncreaseRepeatButton>
                    </Track>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="10" /><Setter Property="Width" Value="Auto" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>